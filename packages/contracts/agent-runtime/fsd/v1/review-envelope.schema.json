{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/fsd/v1/review-envelope.schema.json",
  "title": "服务端顾问确认记录（禁止由模型签发）",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "specId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": ["draft", "awaiting_confirmation", "completed"]
    },
    "verificationSummary": {
      "type": "string",
      "enum": ["verified", "partial", "unverified", "conflicting"]
    },
    "unresolvedIssueIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
      },
      "minItems": 0,
      "description": "对应规格所有status不等于resolved的问题ID，包含accepted；服务端按当前版本计算。",
      "uniqueItems": true
    },
    "confirmation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "actorId": {
              "type": "string",
              "minLength": 1
            },
            "confirmedAt": {
              "type": "string",
              "format": "date-time"
            },
            "specId": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "contentSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "decision": {
              "const": "confirm_complete"
            },
            "acknowledgedIssueIds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
              },
              "minItems": 0
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "actorId",
            "confirmedAt",
            "specId",
            "revision",
            "contentSha256",
            "decision",
            "acknowledgedIssueIds",
            "note"
          ]
        }
      ]
    }
  },
  "required": [
    "specId",
    "revision",
    "status",
    "verificationSummary",
    "unresolvedIssueIds",
    "confirmation"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "confirmation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "actorId": {
                "type": "string",
                "minLength": 1
              },
              "confirmedAt": {
                "type": "string",
                "format": "date-time"
              },
              "specId": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "contentSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "decision": {
                "const": "confirm_complete"
              },
              "acknowledgedIssueIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
                },
                "minItems": 0
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "actorId",
              "confirmedAt",
              "specId",
              "revision",
              "contentSha256",
              "decision",
              "acknowledgedIssueIds",
              "note"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "confirmation": {
            "type": "null"
          }
        }
      }
    }
  ]
}
