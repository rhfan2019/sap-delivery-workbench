{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/fsd/v1/e.schema.json",
  "title": "ABAP功能说明书 — 增强",
  "description": "FSD v1契约。产品输出为功能说明书而非TSD；未知使用open和问题引用。Schema与本地引用校验不证明证据或顾问确认真实，服务端必须校验来源。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "specId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "riceType": {
      "const": "E"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "systemContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selectionId": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "discoveryStatus": {
          "type": "string",
          "enum": ["not_selected", "pending", "available", "unavailable", "partial"]
        },
        "product": {
          "$ref": "#/$defs/decision"
        },
        "productVersion": {
          "$ref": "#/$defs/decision"
        },
        "deployment": {
          "$ref": "#/$defs/decision"
        },
        "abapVersion": {
          "$ref": "#/$defs/decision"
        },
        "identificationSource": {
          "type": "string",
          "enum": ["mcp", "consultant", "mixed", "unknown"]
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
          },
          "minItems": 0
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "selectionId",
        "discoveryStatus",
        "product",
        "productVersion",
        "deployment",
        "abapVersion",
        "identificationSource",
        "evidenceIds",
        "limitations"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "included": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": ["included", "excluded"]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      },
      "minItems": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      },
      "minItems": 1
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      },
      "minItems": 1
    },
    "sapObjects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sapObject"
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      },
      "minItems": 0
    },
    "tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/test"
      },
      "minItems": 1
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "businessTrigger": {
          "$ref": "#/$defs/decision"
        },
        "hostProcess": {
          "type": "string",
          "minLength": 1
        },
        "enhancementObjectId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
        },
        "signatureAndParameters": {
          "$ref": "#/$defs/decision"
        },
        "inputFieldIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
          },
          "minItems": 1
        },
        "outputFieldIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
          },
          "minItems": 0
        },
        "applicabilityFilters": {
          "$ref": "#/$defs/decision"
        },
        "behaviorRuleIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
          },
          "minItems": 1
        },
        "transactionAndCommit": {
          "$ref": "#/$defs/decision"
        },
        "lockingAndConcurrency": {
          "$ref": "#/$defs/decision"
        },
        "errorPropagation": {
          "$ref": "#/$defs/decision"
        },
        "repeatAndReentry": {
          "$ref": "#/$defs/decision"
        },
        "coexistenceAndSequence": {
          "$ref": "#/$defs/decision"
        },
        "performanceTarget": {
          "$ref": "#/$defs/decision"
        },
        "activationAndFallback": {
          "$ref": "#/$defs/decision"
        },
        "standardRegression": {
          "$ref": "#/$defs/decision"
        }
      },
      "required": [
        "businessTrigger",
        "hostProcess",
        "enhancementObjectId",
        "signatureAndParameters",
        "inputFieldIds",
        "outputFieldIds",
        "applicabilityFilters",
        "behaviorRuleIds",
        "transactionAndCommit",
        "lockingAndConcurrency",
        "errorPropagation",
        "repeatAndReentry",
        "coexistenceAndSequence",
        "performanceTarget",
        "activationAndFallback",
        "standardRegression"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "specId",
    "revision",
    "riceType",
    "title",
    "purpose",
    "systemContext",
    "scope",
    "sources",
    "requirements",
    "rules",
    "fields",
    "sapObjects",
    "evidence",
    "issues",
    "tests",
    "contract"
  ],
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["proposed", "consultant_confirmed", "open"]
        },
        "value": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "issueIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
          },
          "minItems": 0
        }
      },
      "required": ["status", "value", "issueIds"],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "open"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "issueIds": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "businessMeaning": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "enum": ["input", "output", "inout"]
        },
        "logicalType": {
          "type": "string",
          "enum": [
            "string",
            "integer",
            "decimal",
            "boolean",
            "date",
            "datetime",
            "binary",
            "object",
            "array"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "cardinality": {
          "type": "string",
          "minLength": 1
        },
        "sourcePath": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "targetPath": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "format": {
          "$ref": "#/$defs/decision"
        },
        "defaultRule": {
          "$ref": "#/$defs/decision"
        },
        "validationRule": {
          "$ref": "#/$defs/decision"
        },
        "mappingRule": {
          "$ref": "#/$defs/decision"
        },
        "unitCurrencyRule": {
          "$ref": "#/$defs/decision"
        },
        "sapObjectIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
          },
          "minItems": 0
        },
        "businessLabel": {
          "type": "string",
          "minLength": 1,
          "description": "顾问阅读的业务字段名称；缺省时使用既有字段含义，不改变字段标识或映射。"
        },
        "inputStyle": {
          "$ref": "#/$defs/decision",
          "description": "输入方式的建议或待确认表达，例如单值、多值、区间。"
        },
        "displayRule": {
          "$ref": "#/$defs/decision",
          "description": "显示、排序、编辑要求的建议或待确认表达；不隐含已批准编辑。"
        }
      },
      "required": [
        "id",
        "name",
        "businessMeaning",
        "direction",
        "logicalType",
        "required",
        "cardinality",
        "sourcePath",
        "targetPath",
        "format",
        "defaultRule",
        "validationRule",
        "mappingRule",
        "unitCurrencyRule",
        "sapObjectIds"
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "acceptanceCriterion": {
          "type": "string",
          "minLength": 1
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
          },
          "minItems": 0
        }
      },
      "required": ["id", "description", "acceptanceCriterion", "sourceIds"]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
        },
        "requirementIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
          },
          "minItems": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "$ref": "#/$defs/decision"
        }
      },
      "required": ["id", "requirementIds", "description", "decision"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
        },
        "kind": {
          "type": "string",
          "enum": ["user_message", "processed_attachment", "system_export", "reference_document"]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["id", "kind", "label", "reference"]
    },
    "sapObject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "table",
            "structure",
            "field",
            "data_element",
            "domain",
            "bapi",
            "function_module",
            "class_method",
            "enhancement",
            "transaction",
            "api",
            "other"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "verificationStatus": {
          "type": "string",
          "enum": [
            "unverified",
            "verified",
            "partial",
            "not_found",
            "unreadable",
            "conflicting",
            "stale"
          ]
        },
        "verificationScope": {
          "type": "string",
          "minLength": 1
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
          },
          "minItems": 0
        },
        "issueIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "purpose",
        "verificationStatus",
        "verificationScope",
        "evidenceIds",
        "issueIds"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "verificationStatus": {
                "const": "verified"
              }
            }
          },
          "then": {
            "properties": {
              "evidenceIds": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
        },
        "channel": {
          "type": "string",
          "enum": ["mcp", "consultant_material", "consultant_statement"]
        },
        "sourceReference": {
          "type": "string",
          "minLength": 1
        },
        "systemFingerprint": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "channel",
        "sourceReference",
        "systemFingerprint",
        "capturedAt",
        "claim",
        "limitations"
      ]
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
        },
        "category": {
          "type": "string",
          "enum": [
            "business",
            "sap_object",
            "interface_contract",
            "conversion",
            "enhancement",
            "test",
            "system",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "status": {
          "type": "string",
          "enum": ["open", "resolved", "accepted"],
          "description": "open和accepted均属未解决；accepted表示知悉处置或风险，不等于对象已核验。resolved需要解决说明。"
        },
        "suggestion": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "followUp": {
          "type": "string",
          "minLength": 1
        },
        "relatedIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
          },
          "minItems": 0
        },
        "resolution": {
          "type": ["string", "null"],
          "minLength": 1
        }
      },
      "required": [
        "id",
        "category",
        "description",
        "impact",
        "priority",
        "status",
        "suggestion",
        "owner",
        "followUp",
        "relatedIds",
        "resolution"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["resolved", "accepted"]
              }
            }
          },
          "then": {
            "properties": {
              "resolution": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
        },
        "requirementIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
          },
          "minItems": 1
        },
        "ruleIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3,}$"
          },
          "minItems": 0
        },
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "preconditions": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "string",
          "minLength": 1
        },
        "expectedResult": {
          "type": "string",
          "minLength": 1
        },
        "verificationMethod": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "requirementIds",
        "ruleIds",
        "scenario",
        "preconditions",
        "input",
        "expectedResult",
        "verificationMethod"
      ]
    }
  }
}
