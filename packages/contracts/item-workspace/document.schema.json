{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "spec", "notes"],
      "properties": {
        "kind": { "const": "design" },
        "spec": { "type": ["object", "null"] },
        "notes": { "type": "string", "maxLength": 100000 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "overview", "technicalDesign", "code", "tests", "notes"],
      "properties": {
        "kind": { "const": "development" },
        "title": { "type": "string", "maxLength": 300 },
        "overview": { "type": "string", "maxLength": 100000 },
        "technicalDesign": { "type": "string", "maxLength": 100000 },
        "code": { "type": "string", "maxLength": 200000 },
        "tests": { "type": "string", "maxLength": 100000 },
        "notes": { "type": "string", "maxLength": 100000 }
      }
    }
  ]
}
