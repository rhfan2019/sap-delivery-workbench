{
  "type": "object",
  "additionalProperties": false,
  "required": ["modelId", "rowVersion", "prompt", "requestId"],
  "properties": {
    "modelId": {
      "type": "string",
      "format": "uuid"
    },
    "rowVersion": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "messages": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "content", "status"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "role": {
            "enum": ["user", "assistant"]
          },
          "content": {
            "type": "string",
            "maxLength": 262144
          },
          "status": {
            "enum": ["completed", "failed", "cancelled"]
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "itemId": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "itemRowVersion": {
          "type": ["string", "null"],
          "pattern": "^[1-9][0-9]*$"
        },
        "systemId": {
          "type": ["string", "null"],
          "format": "uuid"
        },
        "environment": {
          "enum": ["DEV", "QAS", "PRD"]
        },
        "consultantVersion": {
          "type": "string",
          "maxLength": 500
        },
        "workspaceStage": { "enum": ["design", "development"] },
        "qasSystemId": {
          "type": ["string", "null"],
          "format": "uuid"
        }
      }
    },
    "action": {
      "enum": ["dialogue", "draft", "auto"]
    },
    "riceType": {
      "enum": ["R", "I", "C", "E", null]
    },
    "conversationId": {
      "type": "string",
      "format": "uuid"
    },
    "attachmentIds": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "resumeRunId": {
      "type": "string",
      "format": "uuid"
    },
    "decisionAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionId", "values"],
      "properties": {
        "decisionId": {
          "type": "string",
          "format": "uuid"
        },
        "values": {
          "type": "object",
          "maxProperties": 3,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "retryRunId": {
      "type": "string",
      "format": "uuid"
    }
  }
}
