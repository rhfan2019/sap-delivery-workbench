{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "context": {
      "$ref": "#/$defs/Context"
    },
    "request_id": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Link"
      }
    },
    "candidate_conclusion": {
      "type": "string"
    },
    "applicability_reason": {
      "type": "string"
    },
    "unresolved": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Issue"
      }
    },
    "next_queries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/VerificationRequest"
      }
    }
  },
  "required": [
    "schema_version",
    "context",
    "request_id",
    "evidence_refs",
    "candidate_conclusion",
    "applicability_reason",
    "unresolved",
    "next_queries"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs-workspace.example/schemas/VerificationProposal.schema.json",
  "title": "VerificationProposal",
  "description": "llm interpretation only",
  "$defs": {
    "Context": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "document_id": {
          "type": "string"
        },
        "base_document_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "context_snapshot_id": {
          "type": "string"
        },
        "template_id": {
          "type": "string"
        },
        "template_version": {
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "session_id",
        "run_id",
        "document_id",
        "base_document_version",
        "context_snapshot_id",
        "template_id",
        "template_version"
      ],
      "additionalProperties": false
    },
    "Issue": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "impact": {
          "type": "string"
        },
        "owner_role": {
          "type": "string",
          "enum": [
            "business",
            "technical",
            "security",
            "product"
          ]
        },
        "blocking": {
          "type": "string",
          "enum": [
            "release",
            "review",
            "none"
          ]
        },
        "entity_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "resolved",
            "superseded"
          ]
        },
        "resolution_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "question",
        "impact",
        "owner_role",
        "blocking",
        "entity_ids",
        "status",
        "resolution_ref"
      ],
      "additionalProperties": false
    },
    "Link": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "conclusion": {
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "locator",
        "conclusion"
      ],
      "additionalProperties": false
    },
    "Target": {
      "type": "object",
      "properties": {
        "system_id": {
          "type": "string"
        },
        "client": {
          "type": "string"
        },
        "release": {
          "type": "string"
        }
      },
      "required": [
        "system_id",
        "client",
        "release"
      ],
      "additionalProperties": false
    },
    "VerificationRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "claim": {
          "type": "string"
        },
        "object_type": {
          "type": "string",
          "enum": [
            "table",
            "field",
            "domain",
            "transaction",
            "interface",
            "enhancement",
            "authorization",
            "behavior"
          ]
        },
        "candidate_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": "string"
        },
        "required_evidence": {
          "type": "string"
        },
        "blocking": {
          "type": "string",
          "enum": [
            "release",
            "review",
            "none"
          ]
        },
        "related_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "target",
        "claim",
        "object_type",
        "candidate_name",
        "scope",
        "required_evidence",
        "blocking",
        "related_ids"
      ],
      "additionalProperties": false
    }
  }
}
