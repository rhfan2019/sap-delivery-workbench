{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "context": {
      "$ref": "#/$defs/Context"
    },
    "title": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Section"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Test"
      }
    },
    "open_issue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mode": {
      "type": "string",
      "enum": [
        "discussion",
        "review_candidate"
      ]
    }
  },
  "required": [
    "schema_version",
    "context",
    "title",
    "sections",
    "tests",
    "open_issue_ids",
    "decision_refs",
    "verification_refs",
    "mode"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs-workspace.example/schemas/FsProposal.schema.json",
  "title": "FsProposal",
  "description": "llm proposal only",
  "$defs": {
    "Block": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "paragraph",
            "table",
            "callout"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Row"
          }
        },
        "classification": {
          "type": "string",
          "enum": [
            "source_fact",
            "assumption",
            "recommendation",
            "pending"
          ]
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rule_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decision_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Link"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "text",
        "columns",
        "rows",
        "classification",
        "requirement_ids",
        "rule_ids",
        "decision_ids",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "Context": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "document_id": {
          "type": "string"
        },
        "base_document_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "context_snapshot_id": {
          "type": "string"
        },
        "template_id": {
          "type": "string"
        },
        "template_version": {
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "session_id",
        "run_id",
        "document_id",
        "base_document_version",
        "context_snapshot_id",
        "template_id",
        "template_version"
      ],
      "additionalProperties": false
    },
    "Link": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "conclusion": {
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "locator",
        "conclusion"
      ],
      "additionalProperties": false
    },
    "Row": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "cells": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "cells"
      ],
      "additionalProperties": false
    },
    "Section": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "template_slot": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Block"
          }
        }
      },
      "required": [
        "id",
        "template_slot",
        "title",
        "blocks"
      ],
      "additionalProperties": false
    },
    "Test": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rule_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "section_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Link"
          }
        }
      },
      "required": [
        "id",
        "title",
        "preconditions",
        "steps",
        "expected",
        "requirement_ids",
        "rule_ids",
        "section_ids",
        "evidence_refs"
      ],
      "additionalProperties": false
    }
  }
}
