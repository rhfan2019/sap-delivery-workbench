{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "attachment_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "parser_version": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "failed"
      ]
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "https://fs-workspace.example/http/SourceRegion.schema.json"
      }
    },
    "unread_regions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "attachment_id",
    "revision",
    "parser_version",
    "state",
    "regions",
    "unread_regions",
    "warnings",
    "created_at"
  ],
  "additionalProperties": false,
  "$id": "https://fs-workspace.example/http/ParseResult.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ParseResult"
}
