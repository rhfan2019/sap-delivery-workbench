{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "system_notice"
      ]
    },
    "content": {
      "type": "string"
    },
    "attachment_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "selection": {
      "anyOf": [
        {
          "$ref": "https://fs-workspace.example/http/Selection.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "session_id",
    "sequence",
    "role",
    "content",
    "attachment_ids",
    "selection",
    "created_at"
  ],
  "additionalProperties": false,
  "$id": "https://fs-workspace.example/http/Message.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Message"
}
