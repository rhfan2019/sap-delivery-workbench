{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "context": {
      "$ref": "#/$defs/Context"
    },
    "id": {
      "type": "string"
    },
    "document_version_id": {
      "type": "string"
    },
    "document_hash": {
      "type": "string"
    },
    "review_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_manifest_hash": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "actor_role": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "approve",
        "reject",
        "withdraw"
      ]
    },
    "reason": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "context",
    "id",
    "document_version_id",
    "document_hash",
    "review_ids",
    "evidence_manifest_hash",
    "policy_version",
    "actor_id",
    "actor_role",
    "action",
    "reason",
    "created_at"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs-workspace.example/schemas/ApprovalRecord.schema.json",
  "title": "ApprovalRecord",
  "description": "server persisted domain",
  "$defs": {
    "Context": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "document_id": {
          "type": "string"
        },
        "base_document_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "context_snapshot_id": {
          "type": "string"
        },
        "template_id": {
          "type": "string"
        },
        "template_version": {
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "session_id",
        "run_id",
        "document_id",
        "base_document_version",
        "context_snapshot_id",
        "template_id",
        "template_version"
      ],
      "additionalProperties": false
    }
  }
}
