{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "waiting_user",
        "waiting_evidence",
        "failed",
        "cancel_requested",
        "cancelled",
        "completed"
      ]
    },
    "node_id": {
      "type": "string"
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "input_snapshot_id": {
      "type": "string",
      "format": "uuid"
    },
    "last_sequence": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "status",
    "node_id",
    "attempt",
    "input_snapshot_id",
    "last_sequence",
    "error_code",
    "updated_at"
  ],
  "additionalProperties": false,
  "$id": "https://fs-workspace.example/http/Run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run"
}
