{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "document_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "format": {
      "type": "string",
      "enum": [
        "pdf",
        "docx"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "ready",
        "failed"
      ]
    },
    "manifest_hash": {
      "type": "string"
    },
    "content_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "document_version_id",
    "format",
    "status",
    "manifest_hash",
    "content_hash",
    "error_code"
  ],
  "additionalProperties": false,
  "$id": "https://fs-workspace.example/http/Export.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Export"
}
