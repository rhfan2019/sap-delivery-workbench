{
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "business_approver",
          "technical_reviewer",
          "publisher"
        ]
      }
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9]+$"
    }
  },
  "required": [
    "user_id",
    "roles",
    "revision"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs-workspace.example/http/FsProjectRoleAssignment.schema.json",
  "title": "FsProjectRoleAssignment"
}
