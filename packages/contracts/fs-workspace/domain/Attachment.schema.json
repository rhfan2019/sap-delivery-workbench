{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5242880
    },
    "mime": {
      "type": "string"
    },
    "sha256": {
      "type": "string"
    },
    "scan_state": {
      "type": "string",
      "enum": [
        "quarantined",
        "clean",
        "rejected",
        "failed"
      ]
    },
    "parse_result": {
      "anyOf": [
        {
          "$ref": "https://fs-workspace.example/http/ParseResult.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "name",
    "size_bytes",
    "mime",
    "sha256",
    "scan_state",
    "parse_result",
    "created_at"
  ],
  "additionalProperties": false,
  "$id": "https://fs-workspace.example/http/Attachment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Attachment"
}
