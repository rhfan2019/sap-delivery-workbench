{
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string"
    },
    "workspace_revision": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "request_id",
    "workspace_revision"
  ],
  "additionalProperties": false,
  "$id": "https://fs-workspace.example/http/Meta.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meta"
}
