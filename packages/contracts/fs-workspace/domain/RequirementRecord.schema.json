{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "context": {
      "$ref": "#/$defs/Context"
    },
    "id": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "kind": {
      "type": "string",
      "enum": [
        "requirement",
        "rule"
      ]
    },
    "content": {
      "$ref": "#/$defs/Proposal"
    },
    "confirmation": {
      "$ref": "#/$defs/Confirmation"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "context",
    "id",
    "revision",
    "kind",
    "content",
    "confirmation",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs-workspace.example/schemas/RequirementRecord.schema.json",
  "title": "RequirementRecord",
  "description": "server persisted domain",
  "$defs": {
    "Confirmation": {
      "type": "object",
      "properties": {
        "subject_id": {
          "type": "string"
        },
        "subject_revision": {
          "type": "integer",
          "minimum": 0
        },
        "subject_hash": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "unconfirmed",
            "confirmed",
            "invalidated",
            "rejected"
          ]
        },
        "actor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "confirmed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "record_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "subject_id",
        "subject_revision",
        "subject_hash",
        "state",
        "actor_id",
        "confirmed_at",
        "record_id"
      ],
      "additionalProperties": false
    },
    "Context": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "document_id": {
          "type": "string"
        },
        "base_document_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "context_snapshot_id": {
          "type": "string"
        },
        "template_id": {
          "type": "string"
        },
        "template_version": {
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "session_id",
        "run_id",
        "document_id",
        "base_document_version",
        "context_snapshot_id",
        "template_id",
        "template_version"
      ],
      "additionalProperties": false
    },
    "Link": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "conclusion": {
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "locator",
        "conclusion"
      ],
      "additionalProperties": false
    },
    "Proposal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        },
        "classification": {
          "type": "string",
          "enum": [
            "source_fact",
            "assumption",
            "recommendation",
            "pending"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Link"
          }
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "revision",
        "text",
        "classification",
        "source_refs",
        "depends_on"
      ],
      "additionalProperties": false
    }
  }
}
