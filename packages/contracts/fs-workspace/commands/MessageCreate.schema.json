{
  "type": "object",
  "properties": {
    "client_message_id": {
      "type": "string",
      "format": "uuid"
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "attachment_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "selection": {
      "anyOf": [
        {
          "$ref": "https://fs-workspace.example/http/Selection.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "intent": {
      "type": "string",
      "enum": [
        "analyze",
        "clarify",
        "generate",
        "revise",
        "explain"
      ]
    }
  },
  "required": [
    "client_message_id",
    "content",
    "attachment_ids",
    "selection",
    "intent"
  ],
  "additionalProperties": false,
  "$id": "https://fs-workspace.example/http/MessageCreate.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MessageCreate"
}
