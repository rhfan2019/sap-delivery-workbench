# Local development only. Run npm run setup:env to generate local random passwords.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sap_delivery_workbench_dev
POSTGRES_USER=sap_workbench_owner
POSTGRES_PASSWORD=
APP_DB_USER=sap_workbench_app
APP_DB_PASSWORD=
# Only needed the first time, when npm start (npm run db:setup) creates the role and database above
# on the local PostgreSQL 17 service. Defaults: the OS user on macOS/Linux (Homebrew), postgres on
# Windows, whose installer also sets a password that has to be entered here.
# POSTGRES_ADMIN_USER=postgres
# POSTGRES_ADMIN_PASSWORD=
# Where initdb and pg_ctl live for the isolated test database, if they are not on PATH.
# PG_BIN_DIR=C:/Program Files/PostgreSQL/17/bin
# AES-256-GCM key: 32 random bytes represented by 64 hexadecimal characters.
# Keep separate from database backups. Never replace an existing key blindly.
SAP_CREDENTIAL_KEY=
LLM_CREDENTIAL_KEY=
# Optional HTTP(S) proxy for model providers not directly reachable from the
# deployment host (e.g. api.ofox.ai behind a local Karing proxy). When set, model
# traffic tunnels through this proxy; unset means direct connection.
# LLM_PROXY_URL=http://127.0.0.1:3067
# Optional deployment override; defaults to vendor/abap-adt/dist/index.js.
# SAP_MCP_ENTRY=/opt/mcp-abap-abap-adt-api/dist/index.js
# Legacy temporary verification only; normal project SAP calls never use this profile.
# SAP_MCP_PROFILE_FILE=/run/secrets/sap-profile.json
# Alternatively inject SAP_URL, SAP_USER, SAP_PASSWORD (or SAP_BEARER_TOKEN),
# SAP_CLIENT and SAP_LANGUAGE into the API process environment.
# NODE_EXTRA_CA_CERTS=/run/secrets/sap-ca.pem
# abap-fsd-agent (optional). THINKING=off disables the model's deep thinking (much faster
# with DeepSeek); MAX_OUTPUT_TOKENS caps one model reply; FILES_DIR must be absolute in production.
# ABAP_FSD_AGENT_THINKING=off
# ABAP_FSD_AGENT_MAX_OUTPUT_TOKENS=32768
# ABAP_FSD_AGENT_FILES_DIR=/data/files/abap-fsd-agent
# abap-dev-agent (optional): same meaning as above.
# ABAP_DEV_AGENT_THINKING=off
# ABAP_DEV_AGENT_MAX_OUTPUT_TOKENS=32768
# ABAP_DEV_AGENT_FILES_DIR=/data/files/abap-dev-agent
# Wait for an agent's model call to send its first data (default 300000 ms = 5 minutes).
# AGENT_MODEL_FIRST_BYTE_TIMEOUT_MS=300000

# Optional pgAdmin in Docker (npm run db:admin) at http://127.0.0.1:5051; the email must be a valid address.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=
