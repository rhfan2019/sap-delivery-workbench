{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "context": {
      "$ref": "#/$defs/Context"
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Question"
      }
    },
    "decision_proposals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Proposal"
      }
    },
    "deferred_issue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "context",
    "questions",
    "decision_proposals",
    "deferred_issue_ids",
    "summary"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs-workspace.example/schemas/Clarification.schema.json",
  "title": "Clarification",
  "description": "llm proposal only",
  "$defs": {
    "Choice": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "consequence": {
          "type": "string"
        },
        "recommended": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "consequence",
        "recommended"
      ],
      "additionalProperties": false
    },
    "Context": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "document_id": {
          "type": "string"
        },
        "base_document_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "context_snapshot_id": {
          "type": "string"
        },
        "template_id": {
          "type": "string"
        },
        "template_version": {
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "session_id",
        "run_id",
        "document_id",
        "base_document_version",
        "context_snapshot_id",
        "template_id",
        "template_version"
      ],
      "additionalProperties": false
    },
    "Link": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "conclusion": {
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "locator",
        "conclusion"
      ],
      "additionalProperties": false
    },
    "Proposal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        },
        "classification": {
          "type": "string",
          "enum": [
            "source_fact",
            "assumption",
            "recommendation",
            "pending"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Link"
          }
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "revision",
        "text",
        "classification",
        "source_refs",
        "depends_on"
      ],
      "additionalProperties": false
    },
    "Question": {
      "type": "object",
      "properties": {
        "issue_id": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Choice"
          }
        },
        "decision_subject_id": {
          "type": "string"
        },
        "decision_subject_revision": {
          "type": "integer",
          "minimum": 0
        },
        "decision_subject_hash": {
          "type": "string"
        }
      },
      "required": [
        "issue_id",
        "question",
        "options",
        "decision_subject_id",
        "decision_subject_revision",
        "decision_subject_hash"
      ],
      "additionalProperties": false
    }
  }
}
