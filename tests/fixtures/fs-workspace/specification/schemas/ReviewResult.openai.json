{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "context": {
      "$ref": "#/$defs/Context"
    },
    "review_id": {
      "type": "string"
    },
    "document_hash": {
      "type": "string"
    },
    "ruleset_version": {
      "type": "string"
    },
    "recommendation": {
      "type": "string",
      "enum": [
        "ready_for_human_review",
        "revise",
        "discussion_only"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Finding"
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "entity_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "result": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "not_applicable",
              "not_checked"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "rule_id",
          "entity_ids",
          "result",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "context",
    "review_id",
    "document_hash",
    "ruleset_version",
    "recommendation",
    "findings",
    "coverage",
    "limitations"
  ],
  "additionalProperties": false,
  "title": "ReviewResult",
  "description": "llm advisory review only",
  "$defs": {
    "Context": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "document_id": {
          "type": "string"
        },
        "base_document_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "context_snapshot_id": {
          "type": "string"
        },
        "template_id": {
          "type": "string"
        },
        "template_version": {
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "session_id",
        "run_id",
        "document_id",
        "base_document_version",
        "context_snapshot_id",
        "template_id",
        "template_version"
      ],
      "additionalProperties": false
    },
    "Finding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "rule_id": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "blocker",
            "major",
            "minor",
            "info"
          ]
        },
        "entity_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Link"
          }
        },
        "suggested_fix": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "rule_id",
        "severity",
        "entity_ids",
        "description",
        "evidence_refs",
        "suggested_fix"
      ],
      "additionalProperties": false
    },
    "Link": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "conclusion": {
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "locator",
        "conclusion"
      ],
      "additionalProperties": false
    }
  }
}
