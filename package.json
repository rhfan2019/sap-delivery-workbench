{
  "name": "sap-delivery-workbench",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/contracts"
  ],
  "scripts": {
    "generate:fs": "node scripts/contracts/generate-fs.mjs",
    "check:fs-contracts": "node scripts/contracts/generate-fs.mjs --check",
    "test:fs": "node scripts/testing/run-tests.mjs --fs",
    "test:elements:ui": "playwright test --config playwright.fs.config.mjs elements.spec.ts",
    "test:elements:integration": "node scripts/testing/test-elements-e2e.mjs tests/e2e/fs-workspace/elements-item.mjs",
    "start": "node scripts/dev/components.mjs start",
    "stop": "node scripts/dev/components.mjs stop",
    "setup:env": "node scripts/dev/setup-env.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:stop": "docker compose stop postgres",
    "db:status": "node --env-file=.env scripts/database/status.mjs",
    "db:migrate": "node --env-file=.env scripts/database/migrate.mjs",
    "db:provision": "node --env-file=.env scripts/database/provision.mjs",
    "db:test": "node scripts/testing/run-tests.mjs --database",
    "dev": "node scripts/dev/dev.mjs",
    "build": "npm run build --workspace @sap-delivery-workbench/web",
    "typecheck": "npm run typecheck --workspace @sap-delivery-workbench/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run check:architecture && npm run check:fs-contracts && npm run typecheck && npm run build",
    "bootstrap": "node --env-file=.env scripts/database/bootstrap.mjs",
    "test": "node scripts/testing/run-tests.mjs",
    "verify:sap": "node --env-file=.env scripts/checks/verify-sap-mcp.mjs",
    "setup:sap": "node scripts/vendor/setup-sap-mcp.mjs",
    "test:sap": "node scripts/testing/run-tests.mjs --sap",
    "predev": "node scripts/vendor/setup-sap-mcp.mjs",
    "serve": "node apps/api/src/server.mjs",
    "check:architecture": "node scripts/checks/architecture.mjs",
    "test:unit": "node scripts/testing/run-tests.mjs --unit",
    "test:integration": "node scripts/testing/run-tests.mjs --integration",
    "test:e2e": "npm run test:e2e:node && npm run test:playwright",
    "test:setup": "node scripts/testing/setup-database.mjs",
    "test:playwright": "node scripts/testing/test-elements-e2e.mjs node_modules/@playwright/test/cli.js test --config playwright.fs.config.mjs",
    "test:e2e:node": "node scripts/testing/run-tests.mjs --e2e",
    "fsd:checkpoint:setup": "node --env-file=.env apps/api/src/modules/design-assistant/setup.mjs",
    "fsd:worker": "node --env-file=.env apps/api/src/worker.mjs",
    "fsd:observability": "docker compose -f infra/fsd-observability.compose.yaml up -d",
    "test:fsd:ui": "node scripts/testing/test-elements-e2e.mjs tests/e2e/design-assistant/workbench.mjs",
    "test:fsd:chat:ui": "node scripts/testing/test-elements-e2e.mjs tests/e2e/design-assistant/chat-workbench.mjs",
    "eval:fsd": "node scripts/testing/evaluate-fsd.mjs",
    "fsd:sap:probe": "node apps/api/src/modules/design-assistant/probe.mjs"
  },
  "devDependencies": {
    "@fastify/multipart": "10.1.2",
    "@langchain/langgraph": "1.4.21",
    "@langchain/langgraph-checkpoint-postgres": "1.0.6",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@napi-rs/canvas": "1.0.10",
    "@playwright/test": "1.63.0",
    "@sap-delivery-workbench/api": "*",
    "@sap-delivery-workbench/contracts": "*",
    "@vue/server-renderer": "3.5.43",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "argon2": "^0.45.1",
    "docx": "9.8.1",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.5",
    "json-schema-to-typescript": "15.0.4",
    "jszip": "3.10.2",
    "node-pg-migrate": "9.0.0",
    "pdfjs-dist": "6.3.289",
    "pg": "^8.23.1",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "sanitize-html": "^2.18.0",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vue": "3.5.43",
    "zod": "4.6.5"
  }
}
