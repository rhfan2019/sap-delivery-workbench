{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "document_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "template_version": {
      "type": "string"
    },
    "renderer_version": {
      "type": "string"
    },
    "font_pack_version": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "enum": [
        "docx",
        "pdf"
      ]
    },
    "render_model_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence_manifest_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "watermark_policy": {
      "type": "string",
      "enum": [
        "discussion",
        "approved",
        "superseded",
        "withdrawn",
        "legacy_submission"
      ]
    },
    "created_by": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "document_version_id",
    "content_hash",
    "template_version",
    "renderer_version",
    "font_pack_version",
    "format",
    "render_model_hash",
    "evidence_manifest_hash",
    "watermark_policy",
    "created_by",
    "created_at"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs-workspace.example/schemas/ExportManifest.schema.json",
  "title": "ExportManifest"
}
