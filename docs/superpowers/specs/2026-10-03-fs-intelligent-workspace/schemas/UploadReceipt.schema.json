{
  "type": "object",
  "properties": {
    "attachment_id": {
      "type": "string",
      "format": "uuid"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "client_upload_id": {
      "type": "string",
      "format": "uuid"
    },
    "blob_version": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "media_type": {
      "type": "string"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5242880
    },
    "scan_state": {
      "type": "string",
      "enum": [
        "quarantined",
        "clean",
        "rejected",
        "failed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "attachment_id",
    "workspace_id",
    "client_upload_id",
    "blob_version",
    "sha256",
    "media_type",
    "size_bytes",
    "scan_state",
    "created_at"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs-workspace.example/schemas/UploadReceipt.schema.json",
  "title": "UploadReceipt"
}
