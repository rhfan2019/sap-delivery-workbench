{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "context": {
      "$ref": "#/$defs/Context"
    },
    "id": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "version_number": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string"
    },
    "content_hash": {
      "type": "string"
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "draft",
        "in_review",
        "approved",
        "superseded",
        "withdrawn"
      ]
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Section"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Test"
      }
    },
    "requirement_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rule_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_issue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verifications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Verification"
      }
    },
    "confirmation_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_manifest_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "context",
    "id",
    "revision",
    "version_number",
    "title",
    "content_hash",
    "lifecycle",
    "sections",
    "tests",
    "requirement_refs",
    "rule_refs",
    "decision_refs",
    "open_issue_ids",
    "verifications",
    "confirmation_refs",
    "review_refs",
    "approval_refs",
    "evidence_manifest_ids",
    "created_at",
    "created_by"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs-workspace.example/schemas/FsDocument.schema.json",
  "title": "FsDocument",
  "description": "server persisted domain",
  "$defs": {
    "Block": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "paragraph",
            "table",
            "callout"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Row"
          }
        },
        "classification": {
          "type": "string",
          "enum": [
            "source_fact",
            "assumption",
            "recommendation",
            "pending"
          ]
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rule_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decision_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Link"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "text",
        "columns",
        "rows",
        "classification",
        "requirement_ids",
        "rule_ids",
        "decision_ids",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "Context": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "document_id": {
          "type": "string"
        },
        "base_document_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "context_snapshot_id": {
          "type": "string"
        },
        "template_id": {
          "type": "string"
        },
        "template_version": {
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "session_id",
        "run_id",
        "document_id",
        "base_document_version",
        "context_snapshot_id",
        "template_id",
        "template_version"
      ],
      "additionalProperties": false
    },
    "Link": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "conclusion": {
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "locator",
        "conclusion"
      ],
      "additionalProperties": false
    },
    "Row": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "cells": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "cells"
      ],
      "additionalProperties": false
    },
    "Section": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "template_slot": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Block"
          }
        }
      },
      "required": [
        "id",
        "template_slot",
        "title",
        "blocks"
      ],
      "additionalProperties": false
    },
    "Target": {
      "type": "object",
      "properties": {
        "system_id": {
          "type": "string"
        },
        "client": {
          "type": "string"
        },
        "release": {
          "type": "string"
        }
      },
      "required": [
        "system_id",
        "client",
        "release"
      ],
      "additionalProperties": false
    },
    "Test": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rule_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "section_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Link"
          }
        }
      },
      "required": [
        "id",
        "title",
        "preconditions",
        "steps",
        "expected",
        "requirement_ids",
        "rule_ids",
        "section_ids",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "Verification": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "claim": {
          "type": "string"
        },
        "object_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "unverified",
            "verified",
            "conflict",
            "expired",
            "not_applicable",
            "not_found",
            "unreadable"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "applicability": {
          "type": "string",
          "enum": [
            "pending",
            "supported",
            "unsupported"
          ]
        },
        "applicability_reason": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "target",
        "claim",
        "object_name",
        "scope",
        "status",
        "evidence_ids",
        "checked_at",
        "valid_until",
        "limitations",
        "applicability",
        "applicability_reason"
      ],
      "additionalProperties": false
    }
  }
}
